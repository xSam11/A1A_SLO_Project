# ── Jira credentials ──────────────────────────────────────────────────────────
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your_jira_api_token_here   # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_A1A_PROJECT=A1A
JIRA_OCA_PROJECT=OCA

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#alerts-ticket-slo

# ── Alert thresholds (tune these as you experiment) ───────────────────────────
A1A_IDLE_MINUTES=15
OCA_IDLE_HOURS=7
OCA_MAX_AGE_HOURS=24
ALERT_COOLDOWN_HOURS=1
RULE3_ALERT_ONCE=true

# ── Dedup store ───────────────────────────────────────────────────────────────
DEDUP_STORE_PATH=.alert_state.json
# REDIS_URL=redis://localhost:6379/0    # uncomment to use Redis instead

# ── Poller (only used in --loop mode) ─────────────────────────────────────────
POLL_INTERVAL_SECONDS=300
